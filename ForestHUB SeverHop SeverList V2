local function AggregateAndLoadServers()
    RefreshBtn.Text = "⏳ SCANNING 1-PLAYER..."
    task.spawn(function()
        local allServers = {}
        local cursor = ""
        
        for i = 1, 3 do
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            
            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)
            
            if success and result and result.data then
                for _, server in ipairs(result.data) do
                    if server.id ~= game.JobId and server.playing and server.maxPlayers then
                        if server.playing == 1 then
                            table.insert(allServers, 1, server)
                        elseif server.playing > 1 and server.playing < server.maxPlayers then
                            table.insert(allServers, server)
                        end
                    end
                end
                if result.nextPageCursor then
                    cursor = result.nextPageCursor
                else
                    break
                end
            else
                break
            end
            task.wait(0.2)
        end
        
        cachedServers = allServers
        DisplayServers()
        RefreshBtn.Text = "🔄 LOAD 1-PLAYER SERVERS"
    end)
end

RefreshBtn.MouseButton1Click:Connect(AggregateAndLoadServers)
