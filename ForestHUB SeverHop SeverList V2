local function applyFixLag()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
        UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualityLevel.Level1
    end)

    pcall(function()
        local Lighting = game:GetService("Lighting")
        local Camera = workspace.CurrentCamera
        
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        Lighting.Brightness = 1.2
        Lighting.ClockTime = 18
        Lighting.FogEnd = 9e9
        
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
                v:Destroy()
            end
        end

        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "PerfectBrightnessCC"
        cc.Brightness = -0.05
        cc.Saturation = -0.15
        cc.Parent = Lighting

        if Camera then Camera.FieldOfView = 70 end
    end)

    task.spawn(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            pcall(function()
                if v:IsA("PointLight") or v:IsA("SurfaceLight") or v:IsA("SpotLight") or v:IsA("Highlight") then
                    v:Destroy()
                elseif v:IsA("Part") or v:IsA("UnionOperation") or v:IsA("MeshPart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                    v.CastShadow = false
                elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Beam") then
                    v:Destroy()
                elseif v:IsA("Sound") then
                    v.Volume = 0
                end
            end)
        end
    end)

    local Terrain = workspace:FindFirstChildOfClass("Terrain")
    if Terrain then
        pcall(function()
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveTransparency = 1
            Terrain.WaterTransparency = 1
        end)
    end
end

