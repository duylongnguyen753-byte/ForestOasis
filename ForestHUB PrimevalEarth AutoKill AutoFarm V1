local ESPUpdateTimer = 0

-- ========================================================
-- MAIN LOOP
-- ========================================================
RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    if ESPEnabled then
        ESPUpdateTimer = ESPUpdateTimer + dt
        if ESPUpdateTimer >= 0.3 then
            ESPUpdateTimer = 0
            UpdatePlayerESP()
        end
    end

    if hrp and humanoid then
        pcall(function()
            humanoid.WalkSpeed = CustomSpeed
            humanoid.JumpPower = CustomJumpPower
            if humanoid.UseJumpPower == false then
                humanoid.UseJumpPower = true
            end
        end)
        
        local currentTime = tick()
        
        local globalTargetHrp = GetNearestGlobalTarget()
        
        -- AUTO AIM (KHÓA CỰC CHẮC VÀO MỤC TIÊU GẦN NHẤT)
        if AutoAimActive and globalTargetHrp then
            pcall(function()
                local targetHead = globalTargetHrp.Parent and globalTargetHrp.Parent:FindFirstChild("Head")
                local lookTarget = targetHead or globalTargetHrp
                local targetPos = lookTarget.Position
                local desiredCF = CFrame.new(Camera.CFrame.Position, targetPos)
                Camera.CFrame = Camera.CFrame:Lerp(desiredCF, 1)
            end)
        end

        -- AUTO RUN (FIX CHUẨN XÁC HƯỚNG TIẾN TỚI ĐỐI THỦ)
        if AutoRunActive and globalTargetHrp and not AutoKillActive and not AutoTargetKillActive then
            pcall(function()
                local rawDirection = (globalTargetHrp.Position - hrp.Position)
                local flatDir = Vector3.new(rawDirection.X, 0, rawDirection.Z)
                
                local localMoveDir = hrp.CFrame:VectorToObjectSpace(flatDir)
                if localMoveDir.Magnitude > 0.01 then
                    humanoid:Move(localMoveDir.Unit, true)
                else
                    humanoid:Move(Vector3.new(0, 0, -1), true)
                end
                
                local lookAtTarget = CFrame.new(hrp.Position, Vector3.new(globalTargetHrp.Position.X, hrp.Position.Y, globalTargetHrp.Position.Z))
                hrp.CFrame = hrp.CFrame:Lerp(lookAtTarget, 0.25)
            end)
        end

        -- AUTO ATTACK (TỰ ĐỘNG CẮN NẾU TRONG KHOẢNG CÁCH <= 25)
        if AutoAttackActive and globalTargetHrp and not AutoKillActive and not AutoTargetKillActive then
            local dist = (hrp.Position - globalTargetHrp.Position).Magnitude
            if dist <= 25 then 
                if currentTime - LastAttackTick >= 0.02 then
                    LastAttackTick = currentTime
                    PerformAttack(globalTargetHrp.Parent)
                end
            end
        end
        
        -- ANTI SHAKE CAMERA
        if AntiShakeCameraActive and not AutoAimActive then
            local currentCamCF = Camera.CFrame
            if not LockedCameraPosition then
                LockedCameraPosition = currentCamCF
            else
                LockedCameraPosition = LockedCameraPosition:Lerp(currentCamCF, 0.15)
                Camera.CFrame = LockedCameraPosition
            end
        else
            LockedCameraPosition = nil
        end
        
        if IsAutoFarmRunning then
            local targetPos = FarmPoints[farmIndex]
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            if currentTime - farmTimer >= 10.5 then
                farmIndex = farmIndex + 1
                if farmIndex > #FarmPoints then farmIndex = 1 end
                farmTimer = currentTime
                UpdateFarmStatus()
            end
            return 
        end
        
        local myHealthPercent = humanoid.Health / humanoid.MaxHealth
        
        if EmergencyEscapeToggle and myHealthPercent <= 0.25 and myHealthPercent > 0 then
            CombatState = 2 
        elseif myHealthPercent >= 0.70 or not EmergencyEscapeToggle then
            CombatState = 1 
        end

        local targetHrp = nil
        if AutoTargetKillActive then
            targetHrp = GetSelectedPlayerTargetHRP()
        elseif AutoKillActive then
            targetHrp = GetTarget()
        else
            CurrentPersistentTarget = nil
        end
        
        if targetHrp and targetHrp.Parent then
            local targetChar = targetHrp.Parent
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            
            if targetHum and targetHum.Health > 0 then
                if CombatState == 1 then
                    local targetVelocity = targetHrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
                    local predictionFactor = 0.08
                    local predictedPos = targetHrp.Position + (targetVelocity * predictionFactor)
                    
                    local strictLockPos = predictedPos
                    
                    if AttackModeOption == "Xoay vòng đối thủ" then
                        OrbitAngle = OrbitAngle + (OrbitSpeed * dt)
                        local offsetX = math.cos(OrbitAngle) * OrbitRadius
                        local offsetZ = math.sin(OrbitAngle) * OrbitRadius
                        strictLockPos = predictedPos + Vector3.new(offsetX, 0.5, offsetZ)
                    else
                        local lookVector = targetHrp.CFrame.LookVector
                        strictLockPos = predictedPos - (lookVector * OrbitRadius) + Vector3.new(0, 0.5, 0)
                    end
                    
                    hrp.CFrame = CFrame.new(strictLockPos, targetHrp.Position)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                    local currentDistToTarget = (hrp.Position - targetHrp.Position).Magnitude
                    if currentDistToTarget <= 35 and (currentTime - LastAttackTick >= 0.005) then
                        LastAttackTick = currentTime
                        PerformAttack(targetChar)
                    end
                else
                    local escapePos = targetHrp.Position + Vector3.new(0, SafeHeight, 0)
                    hrp.CFrame = CFrame.new(escapePos, hrp.Position + hrp.CFrame.LookVector)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            else
                CurrentPersistentTarget = nil
            end
        else
            CurrentPersistentTarget = nil
        end
    end
end)
