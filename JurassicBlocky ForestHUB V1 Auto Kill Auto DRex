-- ========================================================
-- FIXED PLAYER ESP LOGIC (Guaranteed 100% Player Coverage)
-- ========================================================
local ESPEnabled = false
local Highlights = {}

local function UpdatePlayerESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if hum.Health > 0 then
                    if not Highlights[player] or Highlights[player].Parent ~= char then
                        if Highlights[player] then 
                            pcall(function() Highlights[player]:Destroy() end) 
                        end
                        
                        local hl = Instance.new("Highlight")
                        hl.Name = "ForestHub_PlayerESP"
                        hl.Adornee = char
                        hl.FillColor = Color3.fromRGB(15, 80, 35) -- Dark Emerald
                        hl.OutlineColor = Color3.fromRGB(0, 255, 100) -- Neon Green LED
                        hl.FillTransparency = 0.3
                        hl.OutlineTransparency = 0
                        hl.Enabled = ESPEnabled
                        hl.Parent = char
                        
                        Highlights[player] = hl
                    else
                        Highlights[player].Enabled = ESPEnabled
                    end
                else
                    if Highlights[player] then
                        Highlights[player].Enabled = false
                    end
                end
            else
                if Highlights[player] then
                    pcall(function() Highlights[player]:Destroy() end)
                    Highlights[player] = nil
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if ESPEnabled then
        UpdatePlayerESP()
    end
end)

local function ToggleESPState(state)
    ESPEnabled = state
    if not ESPEnabled then
        for _, hl in pairs(Highlights) do
            if hl then hl.Enabled = false end
        end
    end
end

