-- ========================================================
-- MAIN LOOP (TÁCH BIỆT RÕ RÀNG AN TOÀN)
-- ========================================================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp and humanoid then
        pcall(function()
            humanoid.WalkSpeed = CustomSpeed
        end)
        
        local currentTime = tick()
        
        -- HỆ THỐNG CHỐNG RUNG CAMERA (Chạy xuyên suốt mượt mà)
        if AntiShakeCameraActive then
            local currentCamCF = Camera.CFrame
            if not LockedCameraPosition then
                LockedCameraPosition = currentCamCF
            else
                LockedCameraPosition = LockedCameraPosition:Lerp(currentCamCF, 0.15)
                Camera.CFrame = LockedCameraPosition
            end
        else
            LockedCameraPosition = nil
        end
        
        -- NHÁNH 1: NẾU BẬT AUTO FARM -> CHỈ CHẠY LỘ TRÌNH, KHÔNG ĐÁNH
        if IsAutoFarmRunning then
            local targetPos = FarmPoints[farmIndex]
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            if currentTime - farmTimer >= 10.0 then
                farmIndex = farmIndex + 1
                if farmIndex > #FarmPoints then farmIndex = 1 end
                farmTimer = currentTime
                UpdateFarmStatus()
            end
            
            return 
        end
        
        -- NHÁNH 2: NẾU TẮT AUTO FARM -> KÍCH HOẠT HỆ THỐNG COMBAT & DEFENSE
        local currentTarget = GetTarget()
        local currentHealth = humanoid.Health
        
        if AutoDodgeActive and currentHealth < LastHealth and currentTarget and not IsDodging and (currentTime - DodgeCooldown > 1.5) then
            IsDodging = true
            DodgeTimer = currentTime
            DodgeCooldown = currentTime
        end
        LastHealth = currentHealth
        
        -- 2.1: AUTO DODGE
        if IsDodging and currentTarget then
            local dodgePos = currentTarget.Position + Vector3.new(0, SafeHeight, 0)
            hrp.CFrame = CFrame.new(dodgePos, hrp.Position + hrp.CFrame.LookVector)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            if currentTime - DodgeTimer >= 0.8 then
                IsDodging = false
                CombatState = 1
                StateTimer = 0
            end
            return
        end
        
        -- 2.2: EMERGENCY ESCAPE
        if EmergencyEscapeActive and humanoid.Health > 0 and (humanoid.Health / humanoid.MaxHealth) < 0.25 and currentTarget then
            local emergencyPos = currentTarget.Position + Vector3.new(0, SafeHeight + 50, 0)
            hrp.CFrame = CFrame.new(emergencyPos, hrp.Position + hrp.CFrame.LookVector)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            return
        end
        
        -- 2.3: AUTO KILL (10s Cắn, 2s Né Lên Cao)
        if AutoKillActive and currentTarget then
            if CombatState == 1 then
                if StateTimer == 0 then
                    StateTimer = currentTime
                end
                
                OrbitAngle = OrbitAngle + (OrbitSpeed * RunService.RenderStepped:Wait())
                
                local targetVelocity = currentTarget.AssemblyLinearVelocity or Vector3.new(0,0,0)
                local predictedPos = currentTarget.Position + (targetVelocity * 0.04)
                
                local offsetX = math.cos(OrbitAngle) * OrbitRadius
                local offsetZ = math.sin(OrbitAngle) * OrbitRadius
                
                local strictLockPos = predictedPos + Vector3.new(offsetX, 0.5, offsetZ)
                hrp.CFrame = CFrame.new(strictLockPos, currentTarget.Position)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                -- Spam cắn liên tục
                if currentTime - LastAttackTick >= 0.05 then
                    LastAttackTick = currentTime
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.wait(0.002)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end)
                end
                
                if currentTime - StateTimer >= AttackDuration then
                    CombatState = 2
                    StateTimer = currentTime
                end
                
            elseif CombatState == 2 then
                local escapePos = currentTarget.Position + Vector3.new(0, SafeHeight, 0)
                hrp.CFrame = CFrame.new(escapePos, hrp.Position + hrp.CFrame.LookVector)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                if currentTime - StateTimer >= EscapeDuration then
                    CombatState = 1
                    StateTimer = 0
                    LockedTarget = nil
                end
            end
        else
            StateTimer = 0
            LockedTarget = nil
        end
    end
end)
