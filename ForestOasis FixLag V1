-- 2. Tinh chỉnh ánh sáng và khóa góc nhìn chống kéo giãn (FOV Lock)
pcall(function()
    local Lighting = game:GetService("Lighting")
    local Camera = workspace.CurrentCamera
    
    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 0
    Lighting.Brightness = 1.2
    Lighting.ClockTime = 18
    Lighting.FogEnd = 9e9
    
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
            v:Destroy()
        end
    end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "PerfectBrightnessCC"
    cc.Brightness = -0.05
    cc.Saturation = -0.15
    cc.Parent = Lighting

    -- Khóa cứng FOV của Camera chống bị bóp méo, kéo giãn màn hình
    if Camera then
        Camera.FieldOfView = 70
        Camera.Changed:Connect(function(property)
            if property == "FieldOfView" and Camera.FieldOfView ~= 70 then
                Camera.FieldOfView = 70
            end
        end)
    end
end)

-- 3. Xóa bỏ Texture, Decal, Particle, chặn chớp sáng đỏ/vàng và dập tắt mọi nguồn sáng từ đồ vật
task.spawn(function()
    -- Vòng lặp quét liên tục để xóa hiệu ứng ám màu đỏ/vàng do nhiệm vụ
    task.spawn(function()
        while true do
            pcall(function()
                local Lighting = game:GetService("Lighting")
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("ColorCorrectionEffect") and v.Name ~= "PerfectBrightnessCC" then
                        v:Destroy()
                    end
                end
                for _, gui in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                    if gui:IsA("Frame") and (gui.BackgroundColor3.R > 0.7 and (gui.BackgroundColor3.G > 0.4 or gui.BackgroundColor3.G < 0.2)) and gui.BackgroundTransparency < 1 then
                        gui.Visible = false
                    end
                end
            end)
            task.wait(0.1)
        end
    end)

    local function cleanPartAndLights(v)
        pcall(function()
            -- Xóa các nguồn sáng phát ra từ đồ vật (Đèn, hiệu ứng phát sáng vùng)
            if v:IsA("PointLight") or v:IsA("SurfaceLight") or v:IsA("SpotLight") or v:IsA("Highlight") then
                v:Destroy()
            elseif v:IsA("Part") or v:IsA("UnionOperation") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
                -- Nếu vật thể là Neon (tự phát sáng chói), đổi về nhựa mịn bình thường
                if v.Material == Enum.Material.Neon then
                    v.Material = Enum.Material.SmoothPlastic
                else
                    v.Material = Enum.Material.SmoothPlastic
                end
                v.Reflectance = 0
                v.CastShadow = false
                v.CanQuery = false
            elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("SpecialMesh") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("Explosion") then
                v:Destroy()
            elseif v:IsA("Sound") then
                v.Volume = 0
            end
        end)
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        cleanPartAndLights(v)
    end
    workspace.DescendantAdded:Connect(cleanPartAndLights)
end)

-- 4. Xóa hiệu ứng nước
local Terrain = workspace:FindFirstChildOfClass("Terrain")
if Terrain then
    pcall(function()
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveTransparency = 1
        Terrain.WaterReflectance = 0
        Terrain.WaterTransparency = 1
    end)
end

-- ==========================================
-- 📊 THANH HIỂN THỊ FPS & PING (KÉO THẢ ĐƯỢC)
-- ==========================================
pcall(function()
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local plr = Players.LocalPlayer

    if CoreGui:FindFirstChild("ForestOasisMinimalBar") then CoreGui.ForestOasisMinimalBar:Destroy() end
    if plr.PlayerGui:FindFirstChild("ForestOasisMinimalBar") then plr.PlayerGui.ForestOasisMinimalBar:Destroy() end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ForestOasisMinimalBar"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = gethui and gethui() or CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 150, 0, 32)
    frame.Position = UDim2.new(0, 50, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(15, 20, 15)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = screenGui

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(46, 204, 113)
    stroke.Thickness = 1.5
    stroke.Parent = frame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 12
    textLabel.Parent = frame

    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local lastUpdate = 0
    RunService.RenderStepped:Connect(function(dt)
        local currentTime = tick()
        if currentTime - lastUpdate >= 0.5 then
            local fps = math.floor(1 / dt)
            local ping = 0
            pcall(function() ping = math.floor(plr:GetNetworkPing() * 1000) end)
            textLabel.Text = "  FPS: " .. fps .. " | Ping: " .. ping .. "ms"
            lastUpdate = currentTime
        end
    end)
end)

