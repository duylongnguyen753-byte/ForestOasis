TabCombat:CreateSection("⚔️ Combat & Boss Automation")

TabCombat:CreateToggle({
    Name = "⚔️ Auto Kill Players (Safe Zone)",
    CurrentValue = false,
    Flag = "AutoKillPlayers",
    Callback = function(v)
        AutoKillActive = v
        if AutoKillActive then
            if BossFarmActive then BossFarmActive = false end
            if AutoTargetKillActive then AutoTargetKillActive = false end
            LockedPlayerTarget = nil
            Connection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local targetHrp = GetLockedPlayer()
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and hum and targetHrp then
                        hum.PlatformStand = true
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        
                        local targetCF = targetHrp.CFrame
                        local targetVel = targetHrp.AssemblyLinearVelocity
                        local predictedPos = targetCF.Position + (targetVel * 0.12)
                        local antiHitOffset = Vector3.new(math.sin(tick() * 25) * 0.5, 0, math.cos(tick() * 25) * 0.5)
                        
                        local finalHeight = SafeHeight + BiteAltitude
                        local safeHoverPos = predictedPos + antiHitOffset + Vector3.new(0, finalHeight, 0)
                        hrp.CFrame = CFrame.new(safeHoverPos, targetHrp.Position + Vector3.new(0, 1, 0))
                        
                        TriggerAttackStable()
                    elseif hum then
                        hum.PlatformStand = false
                    end
                end)
            end)
        else 
            if Connection then Connection:Disconnect() end 
            LockedPlayerTarget = nil
            pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
        end
    end
})

