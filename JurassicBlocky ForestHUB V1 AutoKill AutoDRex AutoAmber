                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            hrp.CFrame = CFrame.new(startPos:Lerp(safeHoverPos, i / steps), targetHrp.Position + Vector3.new(0, 1, 0))
                            task.wait(0.02) 
                        end
                        
                        while IsAutoGoatRunning do
                            local currentTargetHrp = GetLockedGoatGlobal()
                            if not currentTargetHrp or currentTargetHrp.Parent ~= targetHrp.Parent then
                                break
                            end
                            
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            local tPos = currentTargetHrp.Position
                            local tVel = currentTargetHrp.AssemblyLinearVelocity
                            local currentHover = tPos + (tVel * 0.12) + Vector3.new(0, SafeHeight + BiteAltitude, 0)
                            
                            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(currentHover, tPos + Vector3.new(0, 1, 0)), 0.25)
                            UpdateGoatStatus(string.format("• Trạng thái: Đang tấn công Dê\n• Khoảng cách: %.1f studs", (hrp.Position - currentTargetHrp.Position).Magnitude))
                            TriggerAttackStable()
                            task.wait(0.025)
                        end
                    else
                        if hum then hum.PlatformStand = false end
                        UpdateGoatStatus("• Trạng thái: Đã quét sạch Dê trên map. Đang tìm kiếm đợt spawn mới...")
                        task.wait(0.4)
                    end
                end
                pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
            end)
        else
            IsAutoGoatRunning = false
            if GoatConnection then task.cancel(GoatConnection) end
            if NoclipConnection then NoclipConnection:Disconnect() end
            
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                    char.Humanoid.PlatformStand = true
                    task.wait(0.05)
                    char.Humanoid.PlatformStand = false
                end
            end)
            
            UpdateGoatStatus("• Trạng thái: Đang tắt (Offline)")
        end
    end
})

