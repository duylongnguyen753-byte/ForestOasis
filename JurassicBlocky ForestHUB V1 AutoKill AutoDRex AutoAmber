TabFarm:CreateSection("💎 Auto Amber (Tự Động Nhặt Ngọc Amber)")

TabFarm:CreateToggle({
    Name = "🚀 Auto Amber (Bật/Tắt Tự Động Nhặt Amber)",
    CurrentValue = false,
    Flag = "AutoAmberToggle",
    Callback = function(Value)
        IsAutoAmberRunning = Value
        if Value then
            if AutoKillActive then AutoKillActive = false end
            if BossFarmActive then BossFarmActive = false end
            if AutoTargetKillActive then AutoTargetKillActive = false end
            if IsAutoGoatRunning then IsAutoGoatRunning = false end
            
            NoclipConnection = RunService.Stepped:Connect(function()
                if not IsAutoAmberRunning then return end
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end)
            
            InstantPromptConnection = RunService.Heartbeat:Connect(function()
                if not IsAutoAmberRunning then return end
                pcall(function()
                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") then
                            v.HoldDuration = 0
                        end
                    end
                end)
            end)
            
            AmberConnection = task.spawn(function()
                while IsAutoAmberRunning do
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and hum then
                        hum.PlatformStand = true
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        
                        local nearestPart = nil
                        local nearestPrompt = nil
                        local shortestDist = math.huge
                        
                        for _, v in ipairs(Workspace:GetDescendants()) do
                            if v:IsA("ProximityPrompt") then
                                local part = v.Parent:IsA("BasePart") and v.Parent or v.Parent:FindFirstChildWhichIsA("BasePart")
                                if part then
                                    local dist = (hrp.Position - part.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        nearestPart = part
                                        nearestPrompt = v
                                    end
                                end
                            end
                        end
                        
                        if nearestPart and nearestPrompt then
                            UpdateAmberStatus(string.format("• Trạng thái: Đang bay đến Amber (Cách %.1f studs)", shortestDist))
                            
                            local startPos = hrp.Position
                            local targetPos = nearestPart.Position
                            local distance = (startPos - targetPos).Magnitude
                            local steps = math.max(math.floor(distance / 5), 8)
                            
                            for i = 1, steps do
                                if not IsAutoAmberRunning then break end
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                hrp.CFrame = CFrame.new(startPos:Lerp(targetPos, i / steps))
                                task.wait(0.008) 
                            end
                            
                            if not IsAutoAmberRunning then break end
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            hrp.CFrame = CFrame.new(targetPos)
                            
                            UpdateAmberStatus("• Trạng thái: Đã đến nơi\n• Đang tương tác nhặt vật phẩm...")
                            
                            local waitTime = 0
                            while waitTime < 0.25 and IsAutoAmberRunning do
                                pcall(function()
                                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    nearestPrompt.HoldDuration = 0
                                    fireproximityprompt(nearestPrompt, 0)
                                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                    task.wait(0.01)
                                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                                end)
                                task.wait(0.02)
                                waitTime = waitTime + 0.02
                            end
                        else
                            UpdateAmberStatus("• Trạng thái: Không tìm thấy Amber trên map. Đang quét lại...")
                            task.wait(0.4)
                        end
                    else
                        task.wait(0.4)
                    end
                end
                pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
            end)
        else
            IsAutoAmberRunning = false
            if AmberConnection then task.cancel(AmberConnection) end
            if InstantPromptConnection then InstantPromptConnection:Disconnect() end
            if NoclipConnection then NoclipConnection:Disconnect() end
            
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                    char.Humanoid.PlatformStand = false
                end
            end)
            
            UpdateAmberStatus("• Trạng thái: Đang tắt (Offline)")
        end
    end
})

