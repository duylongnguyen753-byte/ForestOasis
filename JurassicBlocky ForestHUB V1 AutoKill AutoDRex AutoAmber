local ESPEnabled = false
local ESPFolder = Instance.new("Folder", Workspace)
ESPFolder.Name = "ForestHub_ESP_Folder"

local function ClearESP()
    for _, v in pairs(ESPFolder:GetChildren()) do
        v:Destroy()
    end
end

local function UpdatePlayerESP()
    ClearESP()
    if not ESPEnabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local hl = Instance.new("Highlight")
                hl.Name = "ESPHighlight"
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(20, 80, 20)   
                hl.OutlineColor = Color3.fromRGB(50, 255, 50) 
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                hl.Parent = ESPFolder
                
                local bg = Instance.new("BillboardGui")
                bg.Name = "ESPNameAndHealth"
                bg.Adornee = hrp
                bg.Size = UDim2.new(0, 200, 0, 60)
                bg.StudsOffset = Vector3.new(0, 3.8, 0)
                bg.AlwaysOnTop = true
                
                local textLabel = Instance.new("TextLabel")
                textLabel.Name = "NameTag"
                textLabel.Size = UDim2.new(1, 0, 0, 25)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = player.Name .. " (" .. player.DisplayName .. ")"
                textLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
                textLabel.TextSize = 14
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.TextStrokeTransparency = 0
                textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                textLabel.Parent = bg
                
                local healthBarBg = Instance.new("Frame")
                healthBarBg.Name = "HealthBarBg"
                healthBarBg.Size = UDim2.new(0, 120, 0, 8)
                healthBarBg.Position = UDim2.new(0.5, -60, 0, 28)
                healthBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                healthBarBg.BorderSizePixel = 0
                healthBarBg.Parent = bg
                
                local bgCorner = Instance.new("UICorner")
                bgCorner.CornerRadius = UDim.new(1, 0)
                bgCorner.Parent = healthBarBg
                
                local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local healthBarFill = Instance.new("Frame")
                healthBarFill.Name = "HealthBarFill"
                healthBarFill.Size = UDim2.new(healthPercent, 0, 1, 0)
                healthBarFill.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
                healthBarFill.BorderSizePixel = 0
                healthBarFill.Parent = healthBarBg
                
                local fillCorner = Instance.new("UICorner")
                fillCorner.CornerRadius = UDim.new(1, 0)
                fillCorner.Parent = healthBarFill
                
                bg.Parent = ESPFolder
            end
        end
    end
end

local function GetLockedPlayer()
    if LockedPlayerTarget and LockedPlayerTarget.Character then
        local hum = LockedPlayerTarget.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LockedPlayerTarget.Character:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp then return hrp end
    end
    
    LockedPlayerTarget = nil
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local nearestPlayer = nil
    local shortestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (hrp.Position - targetHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestPlayer = targetHrp
                    LockedPlayerTarget = player
                end
            end
        end
    end
    return nearestPlayer
end

local function GetSelectedPlayerTargetHRP()
    if not SelectedTargetPlayerName or SelectedTargetPlayerName == "" or SelectedTargetPlayerName == "Không có ai khác" then
        return nil
    end
    
    local targetPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == SelectedTargetPlayerName or p.DisplayName == SelectedTargetPlayerName then
            targetPlayer = p
            break
        end
    end
    
    if targetPlayer and targetPlayer.Character then
        local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function GetLockedBossGlobal()
    if LockedBossTarget and LockedBossTarget.Parent then
        local hum = LockedBossTarget.Parent:FindFirstChildOfClass("Humanoid")
        local hrp = LockedBossTarget
        if hum and hum.Health > 0 and hrp then return hrp end
    end
    
    LockedBossTarget = nil
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    local nearestBoss = nil
    local shortestDist = math.huge
    
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") then
            local nameUpper = string.upper(v.Name)
            if (string.find(nameUpper, "D-REX") or string.find(nameUpper, "DREX") or string.find(nameUpper, "BOSS")) and not Players:GetPlayerFromCharacter(v) then
                local targetHrp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
                local targetHum = v:FindFirstChildOfClass("Humanoid")
                
                if targetHrp and targetHum and targetHum.Health > 0 then
                    local dist = hrp and (hrp.Position - targetHrp.Position).Magnitude or 0
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestBoss = targetHrp
                        LockedBossTarget = targetHrp
                    end
                end
            end
        end
    end
    return nearestBoss
end

local function TriggerAttackStable()
    local currentTime = tick()
    if currentTime - LastAttackTick >= AttackSpeed then
        LastAttackTick = currentTime
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                if backpack then
                    tool = backpack:FindFirstChildOfClass("Tool")
                    if tool then LocalPlayer.Character.Humanoid:EquipTool(tool) end
                end
            end
            
            if tool then tool:Activate() end
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    end
end

